{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "^/$",                           "dest": "/api/index.php" },
    { "src": "^/home\\.php$",                 "dest": "/api/index.php" },
    { "src": "^/([a-zA-Z0-9_-]+\\.php)$",    "dest": "/api/$1" }
  ]
}
